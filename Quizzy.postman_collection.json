      "name": "Study Flow",
      "item": [
        {
          "name": "Study - Start Study Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function objectIdToString(value) {",
                  "  if (!value) return undefined;",
                  "  if (typeof value === 'string') return value;",
                  "  if (value.$oid) return value.$oid;",
                  "  if (value.buffer) {",
                  "    return Object.keys(value.buffer)",
                  "      .sort((a, b) => Number(a) - Number(b))",
                  "      .map((key) => Number(value.buffer[key]).toString(16).padStart(2, '0'))",
                  "      .join('');",
                  "  }",
                  "  return undefined;",
                  "}",
                  "",
                  "function saveFirstDueCard(responseBody) {",
                  "  const dueCards = responseBody?.data ?? responseBody ?? [];",
                  "  const firstDueCard = Array.isArray(dueCards) ? dueCards[0] : undefined;",
                  "  const cardId = objectIdToString(firstDueCard?.cardId ?? firstDueCard?._id);",
                  "  const deckId = objectIdToString(firstDueCard?.deckId);",
                  "  if (cardId) pm.collectionVariables.set('cardId', cardId);",
                  "  if (deckId) pm.collectionVariables.set('deckId', deckId);",
                  "  return cardId;",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "const sessionId = objectIdToString(data?._id);",
                  "const deckId = objectIdToString(data?.deckId) || pm.collectionVariables.get('deckId');",
                  "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl');",
                  "const accessToken = pm.collectionVariables.get('accessToken') || pm.environment.get('accessToken');",
                  "if (sessionId) pm.collectionVariables.set('studySessionId', sessionId);",
                  "if (deckId) pm.collectionVariables.set('deckId', deckId);",
                  "pm.test('study session created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(sessionId).to.exist;",
                  "});",
                  "",
                  "if (baseUrl && deckId && accessToken) {",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/v1/card-progress/decks/${deckId}/due`,",
                  "    method: 'GET',",
                  "    header: { Authorization: `Bearer ${accessToken}` },",
                  "  }, function (err, res) {",
                  "    if (err) {",
                  "      console.warn('Could not auto-load due cardId', err);",
                  "      return;",
                  "    }",
                  "    const cardId = saveFirstDueCard(res.json());",
                  "    if (!cardId) console.warn('No due card found to save as cardId. Create cards for this deck first.');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
