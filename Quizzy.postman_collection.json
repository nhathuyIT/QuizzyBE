              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user{{$timestamp}}@quizzy.local\",\n  \"password\": \"password123\",\n  \"name\": \"Quizzy User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": [
